# Slack — reuse the values from the app you already run
SLACK_SIGNING_SECRET=replace-me
SLACK_BOT_TOKEN=xoxb-replace-me

# Attio API token with record_permission:read-write, object_configuration:read,
# note:read-write, task:read-write, user_management:read
ATTIO_TOKEN=replace-me

ALLOWED_USERS=U0000000001,U0000000002
SUMMARY_CHANNEL=C0000000001
DEFAULT_OWNER_EMAIL=maggie@example.com
TIMEZONE=America/Los_Angeles

# Cloud Run only. Leave unset locally: the server then keeps state in memory
# and runs Attio writes inline instead of through Cloud Tasks.
# QUEUE_PARENT=projects/PROJECT/locations/us-central1/queues/crm-writes
# TASK_URL=https://SERVICE.run.app/tasks/write
# TASK_AUDIENCE=https://SERVICE.run.app/tasks/write
# QUEUE_INVOKER=crm-queue@PROJECT.iam.gserviceaccount.com
