{
  "name": "attio-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "ALLOWED_USERS": "",
    "SUMMARY_CHANNEL": "",
    "DEFAULT_OWNER_EMAIL": "",
    "TIMEZONE": "America/Los_Angeles"
  }
}
